# Palda CX production .env (lives on the server next to docker-compose.yml, never in Git or the image).
# bootstrap.sh writes the GENERATED values for you on first setup. Fill in the rest.
# Anything marked "or Engine" can instead be set in Engine > Settings (saved encrypted in the database, wins over this file).

# ───────────── Deployment ─────────────
DOCKERHUB_USER=niloticking
TAG=latest
# The public https address of the app. Used for Meta/Google/Zoho callbacks, payment and review links.
APP_URL=https://jawabu.palda.co.ke
# Host port nginx proxies to (127.0.0.1 only). Change it if another app on this box uses it.
WEB_PORT=3200
DEFAULT_TENANT_SLUG=palda

# ───────────── Secrets (GENERATED by bootstrap.sh) ─────────────
POSTGRES_PASSWORD=
# 48+ random chars: openssl rand -base64 48
AUTH_SECRET=
# 64 hex chars: openssl rand -hex 32. NEVER change it once there is data: it decrypts every stored token and key.
ENCRYPTION_KEY=
INTERNAL_SECRET=
MCP_TOKEN_SECRET=
QDRANT_API_KEY=

# ───────────── WhatsApp / Meta (or Engine > Settings > Meta & WhatsApp) ─────────────
# Set to cloud once the four values below are filled in (cloud refuses to start while any is empty).
WHATSAPP_MODE=mock
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
# GENERATED by bootstrap.sh. Paste the same value into Meta > WhatsApp > Configuration > Webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Leave empty unless your Embedded Signup configuration is the older v4 kind.
META_ES_FEATURE_TYPE=

# ───────────── Apps owners connect: Google & Zoho (or Engine > Settings > Google & Zoho) ─────────────
# mock = sample data. live = real sign-in; needs at least one client below. See docs/INTEGRATIONS.md.
INTEGRATIONS_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# ───────────── The agent's model (OpenRouter) ─────────────
# WAMBO_MODEL=mock answers with the offline test agent. A real model id needs OPENROUTER_API_KEY or the app won't start.
OPENROUTER_API_KEY=
# An OpenRouter model id (openrouter.ai/models), e.g. a Claude Sonnet model. Keep mock until the key is set.
WAMBO_MODEL=mock
WAMBO_FALLBACKS=openai/gpt-4.1-mini,google/gemini-2.5-flash
CHEAP_MODEL=deepseek/deepseek-chat
# Knowledge and memory search. openrouter once OPENROUTER_API_KEY is set (then: Engine > a customer > Knowledge > Reindex).
EMBEDDING_MODE=mock
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=
MAX_TURNS_PER_HOUR=20
USD_TO_KES=129

# ───────────── Payments ─────────────
# Each business adds its own Tuma / Paystack / Pesapal keys in its app (Integrations > Payments). These are only the platform
# fallback. mock = simulated payments for every provider.
MPESA_MODE=mock
TUMA_EMAIL=
TUMA_API_KEY=
TUMA_API_BASE_URL=https://api.tuma.co.ke
# Needed for MPESA_MODE=tuma: https://<your domain>/api/mpesa/callback?tenant=palda
TUMA_CALLBACK_URL=
MPESA_CALLBACK_URL=

# ───────────── Other ─────────────
MEETINGS_MODE=mock
WHATSAPP_MANAGER_PHONE=
# Optional tracing.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
